datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  type       String   @default("EMAIL_VERIFICATION") // "EMAIL_VERIFICATION" or "PASSWORD_RESET"

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Project {
  id           String   @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String?  @map("thumbnail_url")
  nodeCount    Int      @default(1) @map("node_count")
  folder       String?  @default("Personal")
  tags         String[] @default([])
  isArchived   Boolean  @default(false) @map("is_archived")
  isDefault    Boolean  @default(false) @map("is_default")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes  MindMapNode[]
  edges  MindMapEdge[]
  shares ProjectShare[]

  @@map("projects")
}

model MindMapNode {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  parentId    String?  @map("parent_id")
  text        String
  description String?
  icon        String?  // emoji or icon string
  color       String   @default("#6366f1")
  positionX   Float    @map("position_x")
  positionY   Float    @map("position_y")
  collapsed   Boolean  @default(false)
  isRoot      Boolean  @default(false) @map("is_root")
  imageUrl    String?  @map("image_url")
  videoUrl    String?  @map("video_url")
  linkUrl     String?  @map("link_url")
  linkLabel   String?  @map("link_label")
  attachments String?  // JSON serialized array of multiple attachments if any
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("mind_map_nodes")
}

model MindMapEdge {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  source    String   // source node ID
  target    String   // target node ID
  color     String?  @default("#6366f1")
  animated  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("mind_map_edges")
}

model ProjectShare {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  accessLevel String   @default("view") @map("access_level") // "view", "comment", "edit"
  token       String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_shares")
}
